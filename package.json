{
  "name": "walletbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "node ./scripts/start-dev.mjs",
    "dev:no-sync": "next dev --hostname 127.0.0.1 --port 3000",
    "worker": "tsx src/worker/index.ts",
    "build": "node ./scripts/prisma-generate-safe.mjs --no-restart && next build",
    "start": "node ./scripts/start-next.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy:base": "hardhat run scripts/deploy-autopilot-rebalancer.cjs --network base",
    "sync:once": "tsx scripts/sync-once.ts",
    "db:generate": "node ./scripts/prisma-generate-safe.mjs",
    "db:generate:raw": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@next/env": "^16.2.6",
    "@prisma/client": "^6.8.2",
    "clsx": "^2.1.1",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "telegraf": "^4.16.3",
    "viem": "^2.30.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "playwright": "^1.60.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
